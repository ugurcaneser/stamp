<Project Sdk="Microsoft.NET.Sdk">

  <!-- Platform-neutral on purpose: everything except WindowsVolume/DiskTools'
       Windows calls runs (and is tested) on macOS and Linux too. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StampCore.Tests" />
  </ItemGroup>

</Project>
