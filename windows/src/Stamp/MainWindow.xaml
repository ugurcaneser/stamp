<Window x:Class="Stamp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Stamp"
        Title="Stamp" Width="600" Height="760" MinWidth="520" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <local:InverseVisibilityConverter x:Key="NotVisible" />
    <local:PresentConverter x:Key="Present" />
    <local:PercentConverter x:Key="Percent" />
  </Window.Resources>

  <Grid>
    <!-- ================= Select ================= -->
    <DockPanel Visibility="{Binding ShowSelect, Converter={StaticResource Visible}}">
      <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
              BorderThickness="0,1,0,0" Padding="24,14">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Format &amp; Copy…" IsDefault="True"
                  IsEnabled="{Binding CanFormat}" Click="OnFormatClicked" />
          <TextBlock Text="{Binding FormatHint}" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,16,0" />
        </DockPanel>
      </Border>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,12">
          <!-- Header -->
          <DockPanel Margin="0,0,0,18">
            <Image DockPanel.Dock="Left" Source="Logo.png" Width="56" Height="56" Margin="0,0,14,0"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Stamp" FontSize="26" FontWeight="SemiBold" />
              <TextBlock Text="Erase a card as FAT32 and copy a zip's contents onto it." Style="{StaticResource Secondary}" />
            </StackPanel>
          </DockPanel>

          <!-- 1. Card -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" ToolTip="Refresh" Padding="8,4" BorderThickness="0" Background="Transparent"
                        Click="OnRefreshClicked">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" />
                </Button>
                <Border Style="{StaticResource StepNumber}">
                  <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Choose a card" FontWeight="SemiBold" VerticalAlignment="Center" />
              </DockPanel>

              <Border Background="{StaticResource FillBrush}" CornerRadius="6" Padding="12"
                      Visibility="{Binding HasNoDisks, Converter={StaticResource Visible}}">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7F1;" FontSize="26"
                             Foreground="{StaticResource SubtleBrush}" Margin="0,0,12,0" />
                  <StackPanel>
                    <TextBlock Text="No card found" />
                    <TextBlock Text="Insert an SD card or USB drive. It shows up here automatically." Style="{StaticResource Secondary}" FontSize="13" />
                  </StackPanel>
                </DockPanel>
              </Border>

              <ListBox ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedDisk}" BorderThickness="0" Background="Transparent"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       Visibility="{Binding HasNoDisks, Converter={StaticResource NotVisible}}">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Margin" Value="0,0,0,6" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="Row" Background="{StaticResource FillBrush}" BorderBrush="Transparent" BorderThickness="1.5"
                                  CornerRadius="6" Padding="12,10">
                            <ContentPresenter />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                              <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7F1;" FontSize="22"
                                 Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0" />
                      <StackPanel>
                        <TextBlock>
                          <Run Text="{Binding DisplayModel, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SizeHuman, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Details}" Style="{StaticResource Secondary}" FontSize="13" />
                        <TextBlock Text="Not marked removable" Foreground="{StaticResource WarningBrush}" FontSize="13"
                                   Visibility="{Binding Removable, Converter={StaticResource NotVisible}}" />
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <TextBlock Text="{Binding ScanError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                         Visibility="{Binding ScanError, Converter={StaticResource Present}}" />
            </StackPanel>
          </Border>

          <!-- 2. Zip -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel Margin="0,0,0,12">
                <Border Style="{StaticResource StepNumber}">
                  <TextBlock Text="2" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Choose a zip file" FontWeight="SemiBold" VerticalAlignment="Center" />
              </DockPanel>

              <Border x:Name="DropZone" AllowDrop="True" CornerRadius="6" Background="{StaticResource FillBrush}"
                      DragEnter="OnDragEnter" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
                <Grid>
                  <!-- dashed outline while empty -->
                  <Rectangle RadiusX="6" RadiusY="6" Stroke="{StaticResource SubtleBrush}" StrokeThickness="1.5" StrokeDashArray="4 3"
                             Visibility="{Binding HasZip, Converter={StaticResource NotVisible}}" />
                  <StackPanel HorizontalAlignment="Center" Margin="0,20"
                              Visibility="{Binding HasZip, Converter={StaticResource NotVisible}}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xF012;" FontSize="30" HorizontalAlignment="Center"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Text="Drop a zip file here" HorizontalAlignment="Center" Margin="0,8" />
                    <Button Content="Choose File…" HorizontalAlignment="Center" Click="OnChooseZipClicked" />
                  </StackPanel>
                  <DockPanel Margin="12,10" Visibility="{Binding HasZip, Converter={StaticResource Visible}}">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xF012;" FontSize="22"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0" />
                    <Button DockPanel.Dock="Right" Content="Change…" VerticalAlignment="Center" Click="OnChooseZipClicked" />
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding ZipName}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding ZipSubtitle}" Style="{StaticResource Secondary}" FontSize="13" />
                    </StackPanel>
                  </DockPanel>
                </Grid>
              </Border>

              <TextBlock Text="{Binding ZipError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                         Visibility="{Binding ZipError, Converter={StaticResource Present}}" />
              <ItemsControl ItemsSource="{Binding ZipWarnings}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- 3. Name -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel Margin="0,0,0,12">
                <Border Style="{StaticResource StepNumber}">
                  <TextBlock Text="3" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Name the card" FontWeight="SemiBold" VerticalAlignment="Center" />
              </DockPanel>
              <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Width="240" HorizontalAlignment="Left"
                       Padding="6,5" BorderBrush="#C8C8C8" />
              <TextBlock Text="{Binding LabelHint}" Style="{StaticResource Secondary}" FontSize="13" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>

    <!-- ================= Progress / result ================= -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowProgress, Converter={StaticResource Visible}}">
      <StackPanel MaxWidth="480" Margin="32" VerticalAlignment="Center">
        <!-- running -->
        <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource Visible}}">
          <Image Source="Logo.png" Width="80" Height="80" RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock Text="Preparing your card…" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,4" />
          <TextBlock Text="{Binding ActivePhaseTitle}" Style="{StaticResource Secondary}" HorizontalAlignment="Center" />
          <ProgressBar Value="{Binding OverallFraction, Converter={StaticResource Percent}, Mode=OneWay}" Height="6" Margin="0,16,0,8"
                       Foreground="{StaticResource AccentBrush}" Background="#E0E0E0" BorderThickness="0" />
          <TextBlock Text="Don't remove the card until Stamp is done." Style="{StaticResource Secondary}" FontSize="13"
                     HorizontalAlignment="Center" Margin="0,0,0,16" />
        </StackPanel>

        <!-- done -->
        <StackPanel Visibility="{Binding Result, Converter={StaticResource Present}}" Margin="0,0,0,16">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE930;" FontSize="64" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" />
          <TextBlock Text="Your card is ready" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,4" />
          <TextBlock Text="{Binding ResultMessage}" Style="{StaticResource Secondary}" TextAlignment="Center" />
          <TextBlock Text="{Binding SkippedMessage}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" TextAlignment="Center"
                     Margin="0,8,0,0" Visibility="{Binding HasSkipped, Converter={StaticResource Visible}}" />
        </StackPanel>

        <!-- failed -->
        <StackPanel Visibility="{Binding Failure, Converter={StaticResource Present}}" Margin="0,0,0,16">
          <TextBlock Style="{StaticResource Icon}" Text="&#xEA39;" FontSize="64" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center" />
          <TextBlock Text="Something went wrong" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,4" />
          <TextBox Text="{Binding Failure, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                   Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>

        <!-- phases -->
        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Visibility="{Binding ShowPhases, Converter={StaticResource Visible}}">
          <ItemsControl ItemsSource="{Binding Phases}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                  <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" Width="22" FontSize="14" />
                  <TextBlock Text="{Binding Title}" Foreground="{Binding TextBrush}" FontSize="13" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <Expander x:Name="DetailsExpander" Header="Details" Margin="0,16,0,0">
          <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" Height="140" Margin="0,8,0,0"
                   FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto" Background="{StaticResource FillBrush}" BorderThickness="0" Padding="8"
                   TextChanged="OnLogChanged" />
        </Expander>

        <Button Style="{StaticResource PrimaryButton}" Content="Prepare Another Card" HorizontalAlignment="Center" Margin="0,20,0,0"
                Visibility="{Binding Result, Converter={StaticResource Present}}" Click="OnBackClicked" />
        <Button Content="Back" HorizontalAlignment="Center" Margin="0,20,0,0" Padding="22,8"
                Visibility="{Binding Failure, Converter={StaticResource Present}}" Click="OnBackClicked" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
